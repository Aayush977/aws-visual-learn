---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SourceRepo from '../../components/SourceRepo.astro';
import { url } from '../../lib/paths';
import { PRACTICE_EXAMS, TOTAL_QUESTIONS, SOURCE, domainMix } from '../../lib/practice-exams';

const mix = domainMix();
const withRefs = PRACTICE_EXAMS.filter((e) => e.questions.some((q) => q.explain)).map((e) => e.n);
---

<BaseLayout
  title="Practice exams"
  description={`${PRACTICE_EXAMS.length} full-length AWS Cloud Practitioner practice exams — ${TOTAL_QUESTIONS} questions in total, scored, shuffled, with a domain breakdown at the end.`}
>
  <div class="wrap page">
    <header class="page__head">
      <p class="page__eyebrow">Mock exams</p>
      <h1>Practice exams</h1>
      <p class="page__lead">
        {PRACTICE_EXAMS.length} full-length Cloud Practitioner mocks — {TOTAL_QUESTIONS} questions
        in all. Sit one end to end, the way you will sit the real thing, and read the domain
        breakdown at the end to find out which quarter of the syllabus is quietly costing you
        marks.
      </p>
      <p class="page__count">
        {TOTAL_QUESTIONS} questions · {PRACTICE_EXAMS.length} papers · answers only
      </p>
    </header>

    <section class="band band--note">
      <h2>Read this before you start</h2>
      <p>
        These questions are <strong>imported, not written here</strong>. They come from a public
        MIT-licensed repository and carry an answer key — not the explanation-on-every-option
        treatment the rest of this site gives you. That is a deliberate trade: what a mock exam is
        for is volume and stamina, and no hand-written bank on a site this size can give you a
        thousand questions.
      </p>
      <p>
        So use them in that order. Learn the idea in the{' '}
        <a href={url('/lessons')}>lessons</a>, prove it stuck on the{' '}
        <a href={url('/quiz')}>practice questions</a> where every wrong option is explained, and
        then come here to find out whether it holds up for ninety minutes straight. When one of
        these trips you up, the domain breakdown tells you which lesson to go back to.
      </p>
      <p class="page__caveat">
        A few are older than the current CLF-C02 blueprint and a handful of answer keys are
        disputed upstream. Treat a surprising answer as a prompt to check the{' '}
        <a href="https://docs.aws.amazon.com/" rel="noopener nofollow">AWS documentation</a>, not as
        gospel.
      </p>
      <SourceRepo
        eyebrow="Where these come from"
        repo={SOURCE.repo}
        url={SOURCE.url}
        licence={SOURCE.licence}
        blurb="The source of every question on this page — a long-running community collection of Cloud Practitioner notes and mock papers, kept as plain markdown. Questions are reproduced under its MIT licence; the scoring, the domain tagging and the interface here are ours."
      />
    </section>

    <section class="band">
      <h2>The papers</h2>
      <p class="band__lead">
        Each one is a sitting in its own right. Order does not matter — pick the next unsat number.
      </p>
      <ul class="grid">
        {
          PRACTICE_EXAMS.map((e) => (
            <li class="card">
              <p class="card__eyebrow">Exam {e.n}</p>
              <h3 class="card__title">
                <a href={url(`/practice/${e.n}`)}>Practice exam {e.n}</a>
              </h3>
              <p class="card__meta">
                {e.questions.length} questions
                {withRefs.includes(e.n) && <span class="card__tag">with reference links</span>}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="band">
      <h2>What the whole bank covers</h2>
      <p class="band__lead">
        Every question here is tagged with the CLF-C02 domain it belongs to, so the score you get
        at the end of a paper is broken down the way the exam guide talks. The tagging is inferred
        from the wording rather than supplied by the source, so read the split as a rough shape,
        not a specification — and note it is not the official weighting, which is the last column.
      </p>
      <ul class="mix">
        {
          mix.map((d) => (
            <li class="mix__row">
              <span class="mix__name">
                <strong>Domain {d.domain}</strong> {d.label}
              </span>
              <span class="mix__bar">
                <span style={`width:${d.share}%`} />
              </span>
              <span class="mix__num">
                {d.count} · {d.share}%
                <span class="mix__target"> (exam: {d.weight}%)</span>
              </span>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .page {
    padding: var(--sp-7) 0;
  }
  .page__head {
    max-width: 46rem;
    margin-bottom: var(--sp-7);
  }
  .page__eyebrow {
    margin: 0 0 var(--sp-2);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .page__lead {
    font-size: var(--step-1);
    color: var(--text-muted);
  }
  .page__count {
    margin: 0;
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .band {
    margin-bottom: var(--sp-7);
  }
  .band h2 {
    margin: 0 0 var(--sp-1);
  }
  .band__lead {
    margin: 0 0 var(--sp-4);
    color: var(--text-muted);
    font-size: var(--step--1);
    max-width: 46rem;
  }
  .band--note {
    max-width: 46rem;
  }
  .band--note p {
    color: var(--text-muted);
    font-size: var(--step--1);
    margin: var(--sp-3) 0;
  }
  .page__caveat {
    padding-left: var(--sp-3);
    border-left: 3px solid var(--border);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    gap: var(--sp-3);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .card {
    position: relative;
    padding: var(--sp-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-raised);
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }
  .card:hover {
    border-color: var(--accent);
  }
  .card__eyebrow {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--aws-orange);
  }
  .card__title {
    margin: 0;
    font-size: var(--step-0);
  }
  .card__title a {
    color: inherit;
    text-decoration: none;
  }
  .card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .card__meta {
    margin: 0;
    font-size: var(--step--1);
    color: var(--text-muted);
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }
  .card__tag {
    font-size: 0.7rem;
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--border);
    border-radius: 999px;
  }

  .mix {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--sp-2);
    max-width: 46rem;
  }
  .mix__row {
    display: grid;
    grid-template-columns: minmax(10rem, 20rem) 1fr auto;
    align-items: center;
    gap: var(--sp-3);
    font-size: var(--step--1);
  }
  .mix__bar {
    height: 8px;
    border-radius: 999px;
    background: var(--bg-sunken);
    border: 1px solid var(--border);
    overflow: hidden;
  }
  .mix__bar span {
    display: block;
    height: 100%;
    background: var(--aws-orange);
  }
  .mix__num {
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
    white-space: nowrap;
  }
  .mix__target {
    opacity: 0.7;
  }

  @media (max-width: 40rem) {
    .mix__row {
      grid-template-columns: 1fr auto;
    }
    .mix__bar {
      grid-column: 1 / -1;
      order: 3;
    }
  }
</style>
