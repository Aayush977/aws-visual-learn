---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LessonCard from '../../components/LessonCard.astro';
import { allLessons, groupByTrack } from '../../lib/lessons';
import { TRACK_META } from '../../content.config';

const lessons = await allLessons();
const groups = groupByTrack(lessons);
---

<BaseLayout
  title="All lessons"
  description="Every AWS lesson on the site, grouped by topic — cloud foundations, security, networking, compute, storage, databases, architecture and billing."
>
  <div class="wrap page">
    <header class="page__head">
      <h1>All lessons</h1>
      <p class="page__lead">
        Grouped by topic and ordered so each one builds on the last. Start at the top if you are
        new; jump straight to a track if you are revising.
      </p>
      <p class="page__count">{lessons.length} lessons</p>
    </header>

    {
      groups.map((g) => (
        <section class="trk" id={g.track}>
          <div class="trk__head">
            <h2>
              <a href={`#${g.track}`}>{TRACK_META[g.track].label}</a>
            </h2>
            <p>{TRACK_META[g.track].blurb}</p>
          </div>
          <ul class="grid">
            {g.lessons.map((l) => (
              <LessonCard
                id={l.id}
                title={l.data.title}
                summary={l.data.summary}
                exams={l.data.exams}
                minutes={l.data.minutes}
              />
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .page {
    padding: var(--sp-7) 0;
  }
  .page__head {
    max-width: 46rem;
    margin-bottom: var(--sp-7);
  }
  .page__lead {
    font-size: var(--step-1);
    color: var(--text-muted);
  }
  .page__count {
    font-size: var(--step--1);
    color: var(--text-muted);
    margin: 0;
  }

  .trk {
    margin-bottom: var(--sp-7);
    scroll-margin-top: 5rem;
  }
  .trk__head {
    margin-bottom: var(--sp-4);
    padding-bottom: var(--sp-2);
    border-bottom: 1px solid var(--border);
  }
  .trk__head h2 {
    margin: 0 0 var(--sp-1);
  }
  .trk__head h2 a {
    color: inherit;
    text-decoration: none;
  }
  .trk__head p {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
    gap: var(--sp-3);
    padding: 0;
    margin: 0;
  }
</style>
