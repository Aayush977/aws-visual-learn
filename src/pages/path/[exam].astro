---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LessonCard from '../../components/LessonCard.astro';
import { lessonsForExam, groupByTrack } from '../../lib/lessons';
import { PRACTICE_EXAMS, TOTAL_QUESTIONS } from '../../lib/practice-exams';
import { url } from '../../lib/paths';
import { EXAMS, EXAM_META, TRACK_META } from '../../content.config';

export function getStaticPaths() {
  return EXAMS.map((exam) => ({ params: { exam: exam.toLowerCase() }, props: { exam } }));
}

const { exam } = Astro.props;
const meta = EXAM_META[exam];
const lessons = await lessonsForExam(exam);
const groups = groupByTrack(lessons);
const totalMinutes = lessons.reduce((sum, l) => sum + l.data.minutes, 0);

/**
 * The mock papers are Cloud Practitioner only, so the path picks up one extra
 * numbered step at the end for CCP and finishes on the lessons for SAA.
 */
const showMocks = exam === 'CCP';

const BLURB: Record<typeof exam, string> = {
  CCP: 'The entry-level exam. It asks what AWS services do, when you would reach for them, how the pricing and support model works, and who is responsible for what. Breadth over depth — you are not expected to configure anything.',
  SAA: 'The first architect exam. Same services, much deeper: it gives you a scenario with constraints (cost, latency, availability, compliance) and asks which combination of services meets them. Knowing what a service does is not enough — you need to know what it does better than the alternatives.',
};
---

<BaseLayout
  title={meta.full}
  description={`A visual study path for the AWS ${meta.full} exam: ${lessons.length} lessons with animated diagrams, mnemonics and practice questions.`}
>
  <div class="wrap page">
    <header class="page__head">
      <p class="page__eyebrow">Study path</p>
      <h1>{meta.full}</h1>
      <p class="page__lead">{BLURB[exam]}</p>
      <p class="page__count">
        {lessons.length} lessons · about {Math.round(totalMinutes / 60)} hour{
          Math.round(totalMinutes / 60) === 1 ? '' : 's'
        } of reading
      </p>
          <p class="rd" data-read-count hidden>
        <span class="rd__bar" aria-hidden="true"><span data-read-bar></span></span>
        <span class="rd__txt"><strong data-read-done>0</strong> of <span data-read-total>0</span> read</span>
      </p>
</header>

    {
      groups.length === 0 ? (
        <p>No lessons tagged for this exam yet.</p>
      ) : (
        groups.map((g, gi) => (
          <section class="trk">
            <div class="trk__head">
              <h2>
                <span class="trk__num">{String(gi + 1).padStart(2, '0')}</span>
                {TRACK_META[g.track].label}
              </h2>
              <p>{TRACK_META[g.track].blurb}</p>
            </div>
            <ul class="grid">
              {g.lessons.map((l, i) => (
                <LessonCard
                  id={l.id}
                  title={l.data.title}
                  summary={l.data.summary}
                  exams={l.data.exams}
                  minutes={l.data.minutes}
                  n={i + 1}
                />
              ))}
            </ul>
          </section>
        ))
      )
    }

    {
      showMocks && (
        <section class="trk">
          <div class="trk__head">
            <h2>
              <span class="trk__num">{String(groups.length + 1).padStart(2, '0')}</span>
              Sit a mock exam
            </h2>
            <p>
              Reading the lessons and holding your nerve for ninety minutes are different skills.
              This is where you find out which one you have.
            </p>
          </div>

          <div class="mock">
            <p class="mock__lead">
              {PRACTICE_EXAMS.length} full-length papers, {TOTAL_QUESTIONS} questions, scored and
              broken down by exam domain. Work through the{' '}
              <a href={url('/quiz/ccp')}>practice questions</a> first — every wrong option there is
              explained — then use these for stamina and to find the domain that is quietly costing
              you marks.
            </p>
            <ul class="mock__list">
              {PRACTICE_EXAMS.slice(0, 3).map((e) => (
                <li>
                  <a class="mock__paper" href={url(`/practice/${e.n}`)}>
                    Exam {e.n}
                    <span>{e.questions.length} questions</span>
                  </a>
                </li>
              ))}
              <li>
                <a class="mock__paper mock__paper--all" href={url('/practice')}>
                  All {PRACTICE_EXAMS.length} papers
                  <span>Pick the next unsat number</span>
                </a>
              </li>
            </ul>
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .page {
    padding: var(--sp-7) 0;
  }
  .page__head {
    max-width: 48rem;
    margin-bottom: var(--sp-7);
  }
  .page__eyebrow {
    margin: 0 0 var(--sp-1);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--aws-orange);
  }
  .page__lead {
    font-size: var(--step-0);
    color: var(--text-muted);
    line-height: 1.6;
  }
  .page__count {
    margin: 0;
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .trk {
    margin-bottom: var(--sp-7);
  }
  .trk__head {
    margin-bottom: var(--sp-4);
    padding-bottom: var(--sp-2);
    border-bottom: 1px solid var(--border);
  }
  .trk__head h2 {
    display: flex;
    align-items: baseline;
    gap: var(--sp-3);
    margin: 0 0 var(--sp-1);
  }
  .trk__num {
    font-size: var(--step-0);
    font-variant-numeric: tabular-nums;
    color: var(--aws-orange);
  }
  .trk__head p {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
    gap: var(--sp-3);
    padding: 0;
    margin: 0;
  }

  .mock {
    padding: var(--sp-4);
    border: 1px solid var(--border);
    border-left: 4px solid var(--aws-orange);
    border-radius: var(--radius-lg);
    background: var(--bg-raised);
  }
  .mock__lead {
    margin: 0 0 var(--sp-4);
    font-size: var(--step--1);
    color: var(--text-muted);
    max-width: 46rem;
  }
  .mock__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: var(--sp-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .mock__paper {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    padding: var(--sp-3);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    color: inherit;
    text-decoration: none;
    font-weight: 650;
  }
  .mock__paper:hover {
    border-color: var(--accent);
  }
  .mock__paper span {
    font-size: var(--step--1);
    font-weight: 400;
    color: var(--text-muted);
  }
  .mock__paper--all {
    border-style: dashed;
  }

  .rd {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin: var(--sp-3) 0 0;
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .rd__bar {
    flex: 1;
    max-width: 16rem;
    height: 6px;
    border-radius: 999px;
    background: var(--bg-sunken);
    border: 1px solid var(--border);
    overflow: hidden;
  }
  .rd__bar span {
    display: block;
    width: 0;
    height: 100%;
    background: var(--aws-green);
    transition: width 0.3s ease;
  }
  .rd__txt strong {
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }
</style>