---
import BaseLayout from './BaseLayout.astro';
import ExamTag from '../components/ExamTag.astro';
import MarkRead from '../components/MarkRead.astro';
import { TRACK_META, type EXAMS, type TRACKS } from '../content.config';
import { url, lessonUrl } from '../lib/paths';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Neighbour {
  id: string;
  title: string;
}

interface Props {
  /** Lesson id, used to remember that this one has been read. */
  id: string;
  title: string;
  summary: string;
  exams: (typeof EXAMS)[number][];
  track: (typeof TRACKS)[number];
  domains?: { CCP?: string; SAA?: string };
  minutes: number;
  hook?: string;
  updated?: Date;
  headings: Heading[];
  prev?: Neighbour;
  next?: Neighbour;
}

const { id, title, summary, exams, track, domains, minutes, hook, updated, headings, prev, next } =
  Astro.props;

// Show only the domains for exams this lesson is actually on, labelled by exam
// so a Cloud Practitioner reader is never shown an SAA-C03 domain name.
const domainTags = exams
  .map((e) => ({ exam: e, domain: domains?.[e] }))
  .filter((d): d is { exam: (typeof EXAMS)[number]; domain: string } => Boolean(d.domain));

// Only h2/h3 make a useful contents list.
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const trackMeta = TRACK_META[track];
---

<BaseLayout title={title} description={summary}>
  <article class="ls">
    <div class="wrap ls__grid">
      <header class="ls__header">
        <nav class="ls__breadcrumb" aria-label="Breadcrumb">
          <a href={url('/lessons')}>Lessons</a>
          <span aria-hidden="true">/</span>
          <a href={`${url('/lessons')}#${track}`}>{trackMeta.label}</a>
        </nav>

        <h1>{title}</h1>
        <p class="ls__summary">{summary}</p>

        <div class="ls__meta">
          {exams.map((e) => <ExamTag exam={e} />)}
          <span class="ls__dot" aria-hidden="true">·</span>
          <span>{minutes} min read</span>
          {
            domainTags.map((d) => (
              <>
                <span class="ls__dot" aria-hidden="true">
                  ·
                </span>
                <span>
                  <strong class="ls__domainExam">{d.exam}</strong> {d.domain}
                </span>
              </>
            ))
          }
        </div>

        {hook && <p class="ls__hook">{hook}</p>}
      </header>

      {
        toc.length > 1 && (
          <nav class="ls__toc" aria-label="On this page">
            <p class="ls__tocTitle">On this page</p>
            <ol>
              {toc.map((h) => (
                <li class={h.depth === 3 ? 'is-sub' : ''}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }

      <div class="ls__body prose">
        <slot />

        <MarkRead id={id} />

        <footer class="ls__foot">
          {
            updated && (
              <p class="ls__updated">
                Last reviewed{' '}
                <time datetime={updated.toISOString()}>
                  {updated.toLocaleDateString('en-GB', {
                    day: 'numeric',
                    month: 'long',
                    year: 'numeric',
                  })}
                </time>
              </p>
            )
          }

          <nav class="ls__pager" aria-label="Lesson navigation">
            {
              prev ? (
                <a class="ls__pagerLink" href={lessonUrl(prev.id)} rel="prev">
                  <span>← Previous</span>
                  <strong>{prev.title}</strong>
                </a>
              ) : (
                <span />
              )
            }
            {
              next && (
                <a class="ls__pagerLink ls__pagerLink--next" href={lessonUrl(next.id)} rel="next">
                  <span>Next →</span>
                  <strong>{next.title}</strong>
                </a>
              )
            }
          </nav>
        </footer>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .ls {
    padding: var(--sp-6) 0 var(--sp-7);
  }

  .ls__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sp-5);
  }

  .ls__header {
    max-width: var(--content-width);
    margin-inline: auto;
    width: 100%;
  }

  .ls__breadcrumb {
    display: flex;
    gap: var(--sp-2);
    font-size: var(--step--1);
    color: var(--text-muted);
    margin-bottom: var(--sp-3);
  }
  .ls__breadcrumb a {
    text-decoration: none;
  }
  .ls__breadcrumb a:hover {
    text-decoration: underline;
  }

  .ls__summary {
    font-size: var(--step-1);
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: var(--sp-4);
  }

  .ls__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--step--1);
    color: var(--text-muted);
    padding-bottom: var(--sp-4);
    border-bottom: 1px solid var(--border);
  }
  .ls__dot {
    opacity: 0.5;
  }
  .ls__domainExam {
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--text);
  }

  .ls__hook {
    margin: var(--sp-5) 0 0;
    padding: var(--sp-4);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--aws-orange) 10%, var(--bg));
    border-left: 4px solid var(--aws-orange);
    font-size: var(--step-0);
    font-weight: 600;
  }

  .ls__toc {
    max-width: var(--content-width);
    margin-inline: auto;
    width: 100%;
    font-size: var(--step--1);
  }
  .ls__tocTitle {
    margin: 0 0 var(--sp-2);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .ls__toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.15rem;
    border-left: 2px solid var(--border);
  }
  .ls__toc li {
    padding-left: var(--sp-3);
  }
  .ls__toc li.is-sub {
    padding-left: var(--sp-5);
  }
  .ls__toc a {
    text-decoration: none;
    color: var(--text-muted);
  }
  .ls__toc a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .ls__body {
    width: 100%;
  }

  .ls__foot {
    margin-top: var(--sp-7);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--border);
  }
  .ls__updated {
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .ls__pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-3);
    margin-top: var(--sp-4);
  }
  .ls__pagerLink {
    display: grid;
    gap: 0.15rem;
    padding: var(--sp-3) var(--sp-4);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--text);
    background: var(--bg-raised);
  }
  .ls__pagerLink:hover {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--text);
  }
  .ls__pagerLink span {
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .ls__pagerLink--next {
    text-align: right;
  }

  /* Sidebar contents once there is room for it. */
  @media (min-width: 1180px) {
    .ls__grid {
      grid-template-columns: minmax(0, 1fr) 15rem;
      column-gap: var(--sp-6);
      align-items: start;
    }
    .ls__header,
    .ls__body {
      grid-column: 1;
    }
    .ls__toc {
      grid-column: 2;
      grid-row: 1 / span 2;
      position: sticky;
      top: 5rem;
      margin-inline: 0;
      max-width: none;
    }
    /* Keep the reading column centred under the header. */
    .ls__header,
    .ls__body {
      margin-inline: auto;
    }
    /*
     * The sidebar takes 15rem plus a 2rem gap, so full-bleed diagrams have to
     * stop short of it. Without this they slide under the contents list.
     */
    .ls__body {
      --bleed-w: min(calc(var(--wide-width) - 17rem), calc(100vw - 20rem));
    }
  }

  @media (max-width: 620px) {
    .ls__pager {
      grid-template-columns: 1fr;
    }
    .ls__pagerLink--next {
      text-align: left;
    }
  }
</style>
